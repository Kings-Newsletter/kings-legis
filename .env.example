# URL pública do portal (usada em canonical, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://kingsnewsletter.com
NEXT_PUBLIC_NEWSLETTER_URL=https://kingsnewsletter.com
NEXT_PUBLIC_EDITORIAL_EMAIL=contact@kingsnewsletter.com

# ------------------------------------------------------------------ Banco
# Mesmo cluster e banco da King's Newsletter. O portal só LÊ as coleções
# legis_items, legis_events e radar_items; nunca lê nem escreve em news ou
# sports. Use um usuário do MongoDB com permissão de leitura apenas nessas
# coleções.
# Sem MONGODB_URI o portal mostra as páginas sem dados (útil no build da CI).
MONGODB_URI=
MONGODB_DB=kings_newsletter

# ----------------------------------------------------------------- Coleta
# A coleta (Câmara, Senado, DOU e tribunais) roda no kings-worker, não aqui.
# As chaves e os limites das fontes ficam configurados lá.
